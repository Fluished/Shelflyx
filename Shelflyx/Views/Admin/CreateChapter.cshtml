@model Shelflyx.Models.Chapter
@{
    ViewData["Title"] = "Add Chapter";
    var series = ViewBag.Series as Shelflyx.Models.Series;
}
<div class="page-container">
    <div class="form-page">
        <h1>Add Chapter</h1>
        @if (series != null)
        {
            <p class="subtitle">@series.Title</p>
        }

        <form asp-action="CreateChapter" method="post" enctype="multipart/form-data" class="admin-form">
            <input asp-for="SeriesId" type="hidden" />

            <div class="form-row">
                <div class="form-group">
                    <label>Chapter Number *</label>
                    <input asp-for="ChapterNumber" type="number" min="1" class="form-input" required />
                </div>
                <div class="form-group">
                    <label>Price (0 = Free)</label>
                    <input asp-for="Price" type="number" min="0" step="1" class="form-input" value="0" />
                </div>
            </div>

            <div class="form-group">
                <label>Chapter Title *</label>
                <input asp-for="Title" class="form-input" placeholder="e.g. The Awakening" required />
            </div>

            <div class="form-group">
                <label>Pages (Images) — Upload in order</label>
                <input type="file" name="pages" accept="image/*" multiple class="form-input" id="pagesInput" />
                <small>Upload multiple images. They'll be ordered by filename.</small>
                <div id="pagePreview" class="page-preview-grid"></div>
            </div>

            <div class="form-actions">
                <a asp-action="ChapterList" asp-route-seriesId="@Model.SeriesId" class="btn-outline">Cancel</a>
                <button type="submit" class="btn-primary">Upload Chapter</button>
            </div>
        </form>
    </div>
</div>

<script>
document.getElementById('pagesInput').addEventListener('change', function() {
    const preview = document.getElementById('pagePreview');
    preview.innerHTML = '';
    Array.from(this.files).forEach((f, i) => {
        const reader = new FileReader();
        reader.onload = e => {
            const div = document.createElement('div');
            div.className = 'page-thumb';
            div.innerHTML = `<img src="${e.target.result}" /><span>Page ${i+1}</span>`;
            preview.appendChild(div);
        };
        reader.readAsDataURL(f);
    });
});
</script>
