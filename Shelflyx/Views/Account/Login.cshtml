@model Shelflyx.Models.ViewModels.Login
@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">⬡ Shelflyx</div>
        <h2>Welcome Back</h2>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-input" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="form-input" placeholder="Your password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary btn-full">Login</button>
        </form>

        <p class="auth-footer">New here? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
