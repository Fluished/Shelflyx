@model Shelflyx.Models.ViewModels.Search
@{
    ViewData["Title"] = "Search";
}

<div class="page-container">
    <h1 class="page-title">Search Series</h1>
    
    <div class="search-panel">
        <form asp-action="Search" method="get" class="search-form">
            <div class="search-row">
                <input type="text" name="query" value="@Model.Query" placeholder="Title, author, keywords..." class="search-input" />
                <button type="submit" class="btn-primary">Search</button>
            </div>
        </form>
    </div>
    
    @if (Model.Results != null && Model.Results.Any())
    {
        <div class="results-container">
            <h2>Search Results (@Model.Results.Count())</h2>
            @foreach (var item in Model.Results)
            {
                <div class="result-item">
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Query))
    {
        <div class="no-results">
            <p>No results found for "@Model.Query"</p>
        </div>
    }
</div>