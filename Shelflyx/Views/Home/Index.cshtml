@model List<Shelflyx.Models.Series>
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-content">
        <h1>Discover Your Next<br><span class="accent">Obsession</span></h1>
        <p>Thousands of manga & webtoon series waiting for you.</p>
        <a asp-controller="Home" asp-action="Search" class="btn-primary btn-lg">Browse All Series</a>
    </div>
    <div class="hero-bg"></div>
</section>

<section class="section">
    <div class="section-header">
        <h2>Latest Releases</h2>
        <a asp-controller="Home" asp-action="Search" class="see-all">See All →</a>
    </div>

    <div class="genre-filters">
        @foreach (var genre in new[] { "All", "Action", "Romance", "Fantasy", "Horror", "Comedy", "Sci-Fi" })
        {
            <a asp-controller="Home" asp-action="Search"
               asp-route-genre="@(genre == "All" ? "" : genre)"
               class="genre-chip @(genre == "All" ? "active" : "")">@genre</a>
        }
    </div>

    <div class="series-grid">
        @foreach (var s in Model)
        {
            var avgRating = s.Ratings.Any() ? s.Ratings.Average(r => r.Stars) : 0;
            var chapterCount = s.Chapters.Count;
            <a asp-controller="Series" asp-action="Details" asp-route-id="@s.SeriesId" class="series-card">
                <div class="series-cover">
                    <img src="@s.CoverImage" alt="@s.Title" loading="lazy" onerror="this.src='/images/default-cover.png'" />
                    <div class="series-badge">@s.Genre</div>
                    @if (s.Chapters.Any(c => c.Price > 0))
                    {
                        <div class="series-paid-badge">Paid</div>
                    }
                </div>
                <div class="series-info">
                    <h3>@s.Title</h3>
                    <p class="series-author">by @s.Author</p>
                    <div class="series-meta">
                        <span class="stars">@(avgRating > 0 ? $"★ {avgRating:F1}" : "No ratings")</span>
                        <span class="chapters">@chapterCount ch.</span>
                    </div>
                </div>
            </a>
        }
        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No series yet. <a asp-controller="Admin" asp-action="CreateSeries">Add some!</a></p>
            </div>
        }
    </div>
</section>
